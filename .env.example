# Optional. The platform is fully functional without it: every AI job falls back
# to a deterministic heuristic, and the UI labels itself "Heuristics" rather than
# implying a model is at work.
ANTHROPIC_API_KEY=

# Bind address. Use 0.0.0.0 in a container, 127.0.0.1 for local development.
HOST=127.0.0.1
PORT=8000

# Alternative provider, used when no Anthropic key is set.
MISTRAL_API_KEY=
